FUNCTION VIRTUAL GLOBAL SCP211::QuitComError::Write
	VAR_INPUT
		input (EAX) 	: DINT;
	END_VAR
	VAR_OUTPUT
		result (EAX) 	: DINT;
	END_VAR

  if input > 0 then
    result := SdiasSafetyManagerFSoE1.QuitError(Mode:=input);
  else
    // invalid mode selected
    result := QuitComError := -7;
  end_if;

