FUNCTION VIRTUAL SCP211::GetFWVersion
	VAR_INPUT
		pData 	: ^CHAR;
		Length 	: UDINT;
	END_VAR
  
  //Check pointer
  if pData then
    //Length of Firmwareversion (HDINT) -> 8Byte +1 byte zero termination
    if Length >= 9 then
      _itoa(udNumber:=FirmwareVersion.Read(), pString:=pData);  
    else
      pData^ := 0;
    end_if; 
  end_if;  

END_FUNCTION
