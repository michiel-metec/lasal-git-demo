		<RemoteServer Name="SDI1011.HwVersion" Name_DESC="Name" GUID_Svr="{D0A7359B-DC0E-4079-8A27-968B09CDBE21}" GUID_Svr_DESC="GUID of the server" DataType="HDINT" DataType_DESC="DataType" GUID_Obj="{DE78228D-8540-4CBE-9907-05CC25BD3C9A}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Hardware version of the safe io module in the format xx.yy (e.g. 16#0120 means v1.20)&#13;&#10;0 means the feature is not supported by the firmware of the SCP" Comment_DESC="Comment of server"/>
