		<RemoteServer Name="SDI1011.RetryCounteruC1" Name_DESC="Name" GUID_Svr="{FDBE491B-4F19-4B40-90F6-E59B9DBD6C7E}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{DE78228D-8540-4CBE-9907-05CC25BD3C9A}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Shows the amount of retry counters of microprocessor 1.&#13;&#10;-1 ... Retrycounter read out is not supported by this firmware version." Comment_DESC="Comment of server"/>
