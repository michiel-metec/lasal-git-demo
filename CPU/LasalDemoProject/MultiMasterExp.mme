		<RemoteServer Name="SCP2111.RetryCounter" Name_DESC="Name" GUID_Svr="{833C80D1-4726-4DCB-B1AB-C268D7D72245}" GUID_Svr_DESC="GUID of the server" DataType="UDINT" DataType_DESC="DataType" GUID_Obj="{C80C4F26-3537-48D6-84D1-804481162DA3}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Number of Retries on SDIAS-Bus." Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP2111.SafetyState" Name_DESC="Name" GUID_Svr="{E7CB83A4-9CB6-4CF1-A7CC-7BA0ECEE54AC}" GUID_Svr_DESC="GUID of the server" DataType="SafetyConfigStateType" DataType_DESC="DataType" GUID_Obj="{C80C4F26-3537-48D6-84D1-804481162DA3}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Shows state of safety module&#13;&#10;&#13;&#10;_ModuleNotFound:&#13;&#10; - Module has not been found at the given position&#13;&#10;&#13;&#10;_WaitForSynchronicity:&#13;&#10; - Waiting to get synchrony with interacting modules&#13;&#10;&#13;&#10;_SafetyClassOK:&#13;&#10; - Module has been found and no errors reported&#13;&#10;&#13;&#10;_MemAllocFailed: &#13;&#10; - Failed to allocate or reallocate some memory for the module&#13;&#10;&#13;&#10;_ReadFWVerFailed:&#13;&#10; - Failed to read firmware version of module&#13;&#10;&#13;&#10;_ReinitConfig:&#13;&#10; - Only for CPU: Config of CPU has changed and update is in progress&#13;&#10;&#13;&#10;_ModFromCfgNotFound (Only for CPU):&#13;&#10; - Module in configuration, which is not physically available and HW-Class is placed&#13;&#10; - Module in configuration, which is not physically available and no HW-Class is placed&#13;&#10; - Module in configuration, which is not a CDIAS module (according to it&apos;s HW-Path)&#13;&#10;&#13;&#10;_UnsafeVarNotFound (Only for CPU):&#13;&#10; - Couldn&apos;t find an unsafe variable in the project. Compare spelling in Designer and in project.&#13;&#10;&#13;&#10;_UnknownCfgError (Only for CPU):&#13;&#10; - Error in reading config or creating routing tables occured.&#13;&#10;&#13;&#10;_AsyncComError: &#13;&#10; - Too many consecutive asynchronous commands failed! Please contact Sigmatek Support! &#13;&#10; &#13;&#10;_DOsIncreasedRestartApp: &#13;&#10; - Number or size of module accesses increased with new safety project! &#13;&#10; - =&gt; Can&apos;t continue, because the new data is not covered by the actual accesses! Restart Application! &#13;&#10; &#13;&#10;_LostPowerSupply: &#13;&#10; - The power supply of the safe CPU has been lost. &#13;&#10; &#13;&#10;_WrongSafetyHW: &#13;&#10; - The Safety objects in the project do not match the physical modules. &#13;&#10; - For every physical module a safety object must be placed in the project!" Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP2111.RunState" Name_DESC="Name" GUID_Svr="{AC4B39CF-C450-47B3-BD68-C1F18B27C5B2}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C80C4F26-3537-48D6-84D1-804481162DA3}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="0: not running&#13;&#10;1: running in operational or temporary operational mode" Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP2111.ServiceMode" Name_DESC="Name" GUID_Svr="{3B6C1CD0-FB6F-4E5D-876A-5748EB4BFC15}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C80C4F26-3537-48D6-84D1-804481162DA3}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="0: operational mode&#13;&#10;1: service mode or temporary operational mode&#13;&#10;2: check configuration phase" Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP2111.ErrorState" Name_DESC="Name" GUID_Svr="{920C8C99-830B-44F5-9846-0B5674671E00}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C80C4F26-3537-48D6-84D1-804481162DA3}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="0: no error&#13;&#10;1: error&#13;&#10;2: communication timeout on input data from other safety modules" Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP2111.QuitComError" Name_DESC="Name" GUID_Svr="{CEC0760C-DB6B-413C-86D2-1394AC7D2C3C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C80C4F26-3537-48D6-84D1-804481162DA3}" GUID_Obj_DESC="GUID of the object" Comment="Write to this server to quit errors at the SCP and pass the error quit mode as input parameter:&#13;&#10;1..Quit communication errors (shown as error of channel in the SafetyDesigner)&#13;&#10;2..Quit general errors at the current module including submodules (all modules known to this one according to its safety configuration)&#13;&#10;3..Quit general errors only at the current module&#13;&#10;&#13;&#10;Server shows actual quit-state&#13;&#10;  3..busy with quitting general errors only at the current module&#13;&#10;  2..busy with quitting general errors at the current module including submodules&#13;&#10;  1..busy with quitting communication errors&#13;&#10;  0..ready&#13;&#10; -1..error at creating a new safety state&#13;&#10; -2..failed to disable user prompt for quit error&#13;&#10; -3..failed to select module via safety number&#13;&#10; -4..error at establishing connection to module (safety designer must not be online at the same time!)&#13;&#10; -5..failed to send the quit error command to the module&#13;&#10; -6..failed to delete the created safety state&#13;&#10; -7..invalid quit error mode selected&#13;&#10; -8..failed to execute requested quit error mode (newer OS or safety DLL necessary)" Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP2111.FirmwareVersion" Name_DESC="Name" GUID_Svr="{8F3F5C75-C854-40F0-AF77-265BE5B0F89A}" GUID_Svr_DESC="GUID of the server" DataType="HDINT" DataType_DESC="DataType" GUID_Obj="{C80C4F26-3537-48D6-84D1-804481162DA3}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Firmware version and module ID&#13;&#10;&#13;&#10;Format:&#13;&#10;16#XXXXYYYY&#13;&#10;&#13;&#10;XXXX = Module-ID&#13;&#10;  0x419 = 1049 =&gt; SCP111&#13;&#10;  0x44F = 1103 =&gt; SCP211&#13;&#10;&#13;&#10;YYYY = Firmware Version" Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP2111.SafetyNumber" Name_DESC="Name" GUID_Svr="{0DD1909A-74F7-40ED-AA41-B2B4DC38FC6B}" GUID_Svr_DESC="GUID of the server" DataType="HDINT" DataType_DESC="DataType" GUID_Obj="{C80C4F26-3537-48D6-84D1-804481162DA3}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Shows the unique safety number of this module" Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP2111.ApplCRC" Name_DESC="Name" GUID_Svr="{9CCAE32A-CDB3-4359-8C5D-C0E88BD21B1C}" GUID_Svr_DESC="GUID of the server" DataType="HDINT" DataType_DESC="DataType" GUID_Obj="{C80C4F26-3537-48D6-84D1-804481162DA3}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Shows the CRC of the safety application (see CRC Dialog in the SafetyDesigner)" Comment_DESC="Comment of server"/>
