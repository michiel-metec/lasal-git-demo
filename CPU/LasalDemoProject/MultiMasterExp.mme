		<RemoteServer Name="SCP2111.ValidationButtonState" Name_DESC="Name" GUID_Svr="{1DC15047-E6B7-43F4-B607-8542024E0AD2}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{C80C4F26-3537-48D6-84D1-804481162DA3}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Shows the state of the validation button&#13;&#10;0: Validation button not used at the moment&#13;&#10;1: Select a command by pressing the button&#13;&#10;2: Command is executed&#13;&#10;3: Error in module" Comment_DESC="Comment of server"/>
